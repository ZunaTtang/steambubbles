# 이 파일을 .env 로 복사하고 값을 채운다. (.env는 커밋 금지 — .gitignore에 포함)

# Neon Postgres 연결 문자열 (https://console.neon.tech)
DATABASE_URL=

# Steam Web API 키 — 일 10만 콜 예산의 전제 조건 (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# /api/cron/* 핸들러 Bearer 인증 시크릿 (임의의 긴 랜덤 문자열)
CRON_SECRET=

# Upstash QStash — 수집 스케줄 트리거 (https://console.upstash.com/qstash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# 모니터링 알림용 Discord 웹훅 URL (데드맨스위치·서킷브레이커 알림)
ALERT_WEBHOOK_URL=
